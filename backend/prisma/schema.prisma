generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    SCHOOL_ADMIN
    TEACHER
    STUDENT
}

enum MarkSheetStatus {
    DRAFT
    SUBMITTED
    APPROVED
    REJECTED
    LOCKED
}

enum ReportType {
    STUDENT_MARKSHEET
    STUDENT_TERM_REPORT
    CLASS_MARKSHEET
    CLASS_SUMMARY
}

enum ReportFormat {
    PDF
    EXCEL
}

enum EmailJobStatus {
    PENDING
    PROCESSING
    SENT
    FAILED
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

model User {
    id       String  @id @default(cuid())
    username String  @unique
    email    String  @unique
    password String?
    role     Role

    authProvider String  @default("local")

    isActive Boolean @default(true)

    mustChangePassword Boolean @default(true)

    failedAttempts Int       @default(0)
    lockedUntil    DateTime?

    firstName   String
    lastName    String
    phone       String?
    address     String?
    dateOfBirth DateTime?
    gender      Gender?
    photoUrl    String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    refreshTokens  RefreshToken[]
    passwordResets PasswordReset[]

    teacherProfile TeacherProfile?
    studentProfile StudentProfile?

    approvedMarkSheets MarkSheet[] @relation("MarkSheetApprover")
    generatedReports   Report[]    @relation("ReportGeneratedBy")
    auditLogs          AuditLog[]  @relation("AuditActor")

    @@index([role])
}

model RefreshToken {
    id        String   @id @default(cuid())
    tokenHash String   @unique
    userId    String
    family    String
    expiresAt DateTime

    revoked   Boolean  @default(false)
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model PasswordReset {
    id        String   @id @default(cuid())
    userId    String
    tokenHash String   @unique
    expiresAt DateTime
    used      Boolean  @default(false)
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model EmailJob {
    id            String         @id @default(cuid())
    type          String
    recipient     String
    payload       Json
    status        EmailJobStatus @default(PENDING)
    attempts      Int            @default(0)
    lastError     String?
    providerId    String?
    lockedAt      DateTime?
    nextAttemptAt DateTime?
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt

    @@index([status, nextAttemptAt, createdAt])
}

model SchoolConfig {
    id            String   @id @default(cuid())
    schoolName    String
    address       String?
    phone         String?
    email         String?
    logoUrl       String?
    minGradeLevel Int      @default(6)
    maxGradeLevel Int      @default(13)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AcademicYear {
    id        String   @id @default(cuid())
    name      String   @unique
    startDate DateTime
    endDate   DateTime
    isCurrent Boolean  @default(false)

    terms                     Term[]
    classes                   Class[]
    teacherSubjectAssignments TeacherSubjectAssignment[]
    teachingAssignments       TeachingAssignment[]
    studentClassEnrollments   StudentClassEnrollment[]
    studentSubjectSelections  StudentSubjectSelection[]
    reports                   Report[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isCurrent])
}

model Term {
    id             String   @id @default(cuid())
    academicYearId String
    name           String
    sequence       Int
    startDate      DateTime
    endDate        DateTime

    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    exam         Exam?
    reports      Report[]

    @@unique([academicYearId, sequence])
    @@index([academicYearId])
}

model Exam {
    id        String    @id @default(cuid())
    termId    String
    name      String
    sequence  Int
    startDate DateTime?
    endDate   DateTime?

    term       Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
    markSheets MarkSheet[]
    reports    Report[]

    @@unique([termId])
}

model GradeLevel {
    id    String @id @default(cuid())
    level Int    @unique
    name  String

    classes  Class[]
    subjects Subject[] @relation("GradeLevelSubjects")
}

model Class {
    id             String  @id @default(cuid())
    name           String
    gradeLevelId   String
    academicYearId String
    classTeacherId String?
    isActive       Boolean @default(true)

    gradeLevel   GradeLevel      @relation(fields: [gradeLevelId], references: [id])
    academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
    classTeacher TeacherProfile? @relation("ClassTeacherOf", fields: [classTeacherId], references: [id])

    enrollments         StudentClassEnrollment[]
    currentStudents      StudentProfile[]         @relation("CurrentClass")
    teachingAssignments  TeachingAssignment[]
    markSheets           MarkSheet[]
    reports              Report[]

    @@unique([academicYearId, classTeacherId])
    @@unique([academicYearId, gradeLevelId, name])
    @@index([academicYearId])
}

model Subject {
    id       String  @id @default(cuid())
    name     String  @unique
    code     String? @unique
    isActive Boolean @default(true)

    gradeLevels GradeLevel[] @relation("GradeLevelSubjects")

    teacherSubjectAssignments TeacherSubjectAssignment[]
    teachingAssignments       TeachingAssignment[]
    studentSubjectSelections  StudentSubjectSelection[]
    markSheets                MarkSheet[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TeacherProfile {
    id            String    @id @default(cuid())
    userId        String    @unique
    employeeNo    String    @unique
    joinedAt      DateTime  @default(now())
    qualification String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    subjectAssignments     TeacherSubjectAssignment[]
    teachingAssignments    TeachingAssignment[]
    classesAsClassTeacher  Class[]                    @relation("ClassTeacherOf")
    markSheetsOwned        MarkSheet[]
}

model TeacherSubjectAssignment {
    id             String    @id @default(cuid())
    teacherId      String
    subjectId      String
    academicYearId String
    isActive       Boolean   @default(true)
    assignedAt     DateTime  @default(now())
    endedAt        DateTime?

    teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
    subject      Subject        @relation(fields: [subjectId], references: [id])
    academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

    @@unique([teacherId, academicYearId])
    @@index([subjectId])
}

model TeachingAssignment {
    id             String    @id @default(cuid())
    teacherId      String
    subjectId      String
    classId        String
    academicYearId String
    isActive       Boolean   @default(true)
    assignedAt     DateTime  @default(now())
    endedAt        DateTime?

    teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
    subject      Subject        @relation(fields: [subjectId], references: [id])
    class        Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
    academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

    @@unique([teacherId, subjectId, classId, academicYearId])
    @@index([classId])
    @@index([teacherId])
}

model StudentProfile {
    id              String   @id @default(cuid())
    userId          String   @unique
    admissionNumber String   @unique
    admissionDate   DateTime @default(now())
    guardianName    String?
    guardianPhone   String?

    currentClassId String?

    user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    currentClass Class? @relation("CurrentClass", fields: [currentClassId], references: [id])

    enrollments       StudentClassEnrollment[]
    subjectSelections StudentSubjectSelection[]
    marks             Mark[]
    reports           Report[]

    @@index([currentClassId])
}

model StudentClassEnrollment {
    id             String    @id @default(cuid())
    studentId      String
    classId        String
    academicYearId String
    enrolledAt     DateTime  @default(now())
    leftAt         DateTime?
    isCurrent      Boolean   @default(true)

    student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
    class        Class          @relation(fields: [classId], references: [id])
    academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

    @@index([studentId, academicYearId])
    @@index([classId])
}

model StudentSubjectSelection {
    id             String   @id @default(cuid())
    studentId      String
    subjectId      String
    academicYearId String
    isActive       Boolean  @default(true)
    selectedAt     DateTime @default(now())

    student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
    subject      Subject        @relation(fields: [subjectId], references: [id])
    academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

    @@unique([studentId, subjectId, academicYearId])
}

model MarkSheet {
    id        String          @id @default(cuid())
    subjectId String
    classId   String
    examId    String
    teacherId String
    status    MarkSheetStatus @default(DRAFT)

    submittedAt     DateTime?
    approvedById    String?
    approvedAt      DateTime?
    rejectionReason String?

    subject    Subject        @relation(fields: [subjectId], references: [id])
    class      Class          @relation(fields: [classId], references: [id])
    exam       Exam           @relation(fields: [examId], references: [id])
    teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
    approvedBy User?          @relation("MarkSheetApprover", fields: [approvedById], references: [id])

    marks Mark[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([subjectId, classId, examId])
    @@index([teacherId])
    @@index([status])
}

model Mark {
    id            String   @id @default(cuid())
    markSheetId   String
    studentId     String
    marksObtained Decimal? @db.Decimal(5, 2)
    maxMarks      Int      @default(100)
    isAbsent      Boolean  @default(false)
    grade         String?
    remarks       String?

    markSheet MarkSheet      @relation(fields: [markSheetId], references: [id], onDelete: Cascade)
    student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([markSheetId, studentId])
    @@index([studentId])
}

model GradeBand {
    id          String  @id @default(cuid())
    grade       String
    minMark     Int
    maxMark     Int
    gradePoint  Float?
    isPassing   Boolean @default(true)
    description String?

    @@index([minMark, maxMark])
}

model Report {
    id             String       @id @default(cuid())
    type           ReportType
    format         ReportFormat
    studentId      String?
    classId        String?
    examId         String?
    termId         String?
    academicYearId String?
    filePath       String?
    generatedById  String

    student      StudentProfile? @relation(fields: [studentId], references: [id])
    class        Class?          @relation(fields: [classId], references: [id])
    exam         Exam?           @relation(fields: [examId], references: [id])
    term         Term?           @relation(fields: [termId], references: [id])
    academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id])
    generatedBy  User            @relation("ReportGeneratedBy", fields: [generatedById], references: [id])

    generatedAt DateTime @default(now())

    @@index([studentId])
    @@index([classId])
}

model AuditLog {
    id            String   @id @default(cuid())
    action        String
    entityType    String
    entityId      String
    performedById String?
    metadata      Json?
    createdAt     DateTime @default(now())

    performedBy User? @relation("AuditActor", fields: [performedById], references: [id])

    @@index([entityType, entityId])
    @@index([performedById])
}
